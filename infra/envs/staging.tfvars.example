# Copie para envs/staging.tfvars (fora do Git) e ajuste. Use uma conta AWS por ambiente.
environment        = "staging"
region             = "sa-east-1"
hosted_zone_id     = "Z0000000000000000000"
app_domain         = "homolog.malha.example"
ingest_domain      = "ingest-homolog.malha.example"
mail_domain        = "malha.example"
entra_tenant_id    = "00000000-0000-0000-0000-000000000000"
entra_client_id    = "00000000-0000-0000-0000-000000000000"
alert_email        = "plataforma@malha.example"
monthly_budget_usd = 150
db_multi_az        = false
single_nat_gateway = true
web_desired_count  = 1
# Primeira aplicação: true. Depois do primeiro deploy pelo GitHub Actions: false.
bootstrap = true
