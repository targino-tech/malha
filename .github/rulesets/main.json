{
  "name": "main protegida",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash",
          "merge"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Web, banco e navegador",
            "integration_id": 15368
          },
          {
            "context": "Coletor Go",
            "integration_id": 15368
          },
          {
            "context": "Imagens Docker",
            "integration_id": 15368
          },
          {
            "context": "Terraform",
            "integration_id": 15368
          },
          {
            "context": "Vulnerabilidades de dependências",
            "integration_id": 15368
          },
          {
            "context": "Análise estática de código",
            "integration_id": 15368
          },
          {
            "context": "Segredos no histórico Git",
            "integration_id": 15368
          },
          {
            "context": "Malware em arquivos do repositório",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (javascript-typescript)",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (go)",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (actions)",
            "integration_id": 15368
          },
          {
            "context": "Revisão de dependências",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
