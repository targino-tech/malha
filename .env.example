# Carregue as variáveis no shell antes de rodar pnpm. O demo usa dados fictícios.
# Nunca exponha o demo na internet: ele entra como administrador sem login.
MALHA_MODE=demo
# MALHA_DEMO_DB=memory://

# Piloto isolado com PostgreSQL e Entra ID.
# MALHA_MODE=pilot
# DATABASE_URL=
# DATABASE_ADMIN_URL=
# MALHA_PUBLIC_ORIGIN=https://app.seudominio.example
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# MALHA_AUTH_SECRET=

# Login por Google Workspace, Okta, Keycloak ou outro OpenID Connect (opcional).
# Redirecionamento no provedor: https://<host-do-app>/api/auth/oidc/callback
# MALHA_OIDC_ISSUER=https://accounts.google.com
# MALHA_OIDC_CLIENT_ID=
# MALHA_OIDC_CLIENT_SECRET=
# MALHA_OIDC_ORG_ID=
# MALHA_OIDC_NAME=Google
# MALHA_OIDC_CLIENT_AUTH=post   # padrão: basic (client_secret_basic)

# Login por AD/LDAP: o diretório é cadastrado com `pnpm db ldap` (veja o README).
# MALHA_LDAP_BIND_PASSWORD_FILE=
# MALHA_LDAP_ID_ATTRIBUTE=objectGUID
# MALHA_LDAP_CA_FILE=
# MALHA_LOCAL_DB_PASSWORD=

# E-mail de alertas críticos enviado pelo worker. Com SES, use o endpoint SMTP da região.
# MALHA_SMTP_URL=smtps://usuario:senha@email-smtp.sa-east-1.amazonaws.com:465
# MALHA_ALERT_FROM=Malha <alertas@seudominio.example>

# Canais de alerta (Telegram e e-mail) cadastrados na aba Alertas: veja docs/alertas.md.
# O token do bot fica cifrado com MALHA_AUTH_SECRET e o envio vai só para https://api.telegram.org.
# MALHA_PUBLIC_ORIGIN acima vira o link do painel nas mensagens. Os canais de e-mail usam o SMTP acima.
